    "from sklearn.feature_selection import RFE\n",
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "\n",
    "# Define the range of K values to test\n",
    "neighbors_settings = range(1, 100)\n",
    "\n",
    "# Accuracy tracking lists\n",
    "training_accuracy = []\n",
    "test_accuracy = []\n",
    "\n",
