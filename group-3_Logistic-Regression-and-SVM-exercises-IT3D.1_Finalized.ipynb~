    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import accuracy_score\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "# Assume df is already loaded and preprocessed\n",
    "# Separate features and target\n",
    "X = df_encoded.drop(\"churn_risk\", axis=1)\n",
    "y = df_encoded[\"churn_risk\"]\n",
    "display(X)\n",
    "\n",
    "# Feature Scaling\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "# Define test sizes and random state range\n",
    "test_sizes = [0.2, 0.25, 0.3, 0.35]\n",
    "random_states = range(1, 51)  # Using random_state from 1 to 50\n",
    "\n",
    "test_size_accuracies = {}\n",
    "\n",
    "# Evaluate average accuracy for each test size over 50 random states\n",
    "for test_size in test_sizes:\n",
    "    accuracies = []\n",
    "    for state in random_states:\n",
    "        X_train, X_test, y_train, y_test = train_test_split(\n",
    "            X_scaled, y, test_size=test_size, random_state=state, stratify=y\n",
    "        )\n",
    "        model = LogisticRegression(max_iter=1000)\n",
    "        model.fit(X_train, y_train)\n",
    "        y_pred = model.predict(X_test)\n",
    "        acc = accuracy_score(y_test, y_pred)\n",
    "        accuracies.append(acc)\n",
    "    avg_acc = np.mean(accuracies)\n",
    "    test_size_accuracies[test_size] = avg_acc\n",
    "    print(f\"Test Size: {test_size}, Avg Accuracy over 50 states: {avg_acc:.4f}\")\n",
    "\n",
    "# Display as a DataFrame\n",
    "test_size_df = pd.DataFrame([\n",
    "    {'Test Size': ts, 'Average Accuracy': acc}\n",
    "    for ts, acc in test_size_accuracies.items()\n",
    "]).sort_values(by='Average Accuracy', ascending=False).reset_index(drop=True)\n",
    "\n",
    "print(\"\\nAverage Accuracy per Test Size (Random States 1–50):\")\n",
    "display(test_size_df)\n",
    "\n",
    "# Select best test size from results\n",
    "best_test_size = test_size_df.iloc[0]['Test Size']\n",
    "\n",
    "# Evaluate accuracy for each random state using the best test size\n",
    "random_state_accuracies = {}\n",
    "\n",
    "for state in random_states:\n",
    "    X_train, X_test, y_train, y_test = train_test_split(\n",
    "        X_scaled, y, test_size=best_test_size, random_state=state, stratify=y\n",
    "    )\n",
    "    model = LogisticRegression(max_iter=1000)\n",
    "    model.fit(X_train, y_train)\n",
    "    y_pred = model.predict(X_test)\n",
    "    acc = accuracy_score(y_test, y_pred)\n",
    "    random_state_accuracies[state] = acc\n",
    "\n",
    "# Convert to DataFrame for easy viewing\n",
    "random_state_df = pd.DataFrame([\n",
    "    {'Random State': rs, 'Accuracy': acc}\n",
